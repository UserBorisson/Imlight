  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Imlight.CoreLib/Imlight.CoreLib.csproj" />
    <ProjectReference Include="$(SchoolContentCompilerProject)" />
  </ItemGroup>
</Project>
