<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <SchoolContentCompilerProject Condition="Exists('$(MSBuildThisFileDirectory)../../../../tools/SchoolContentCompiler/SchoolContentCompiler.csproj')">$(MSBuildThisFileDirectory)../../../../tools/SchoolContentCompiler/SchoolContentCompiler.csproj</SchoolContentCompilerProject>
